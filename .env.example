# ══════════════════════════════════════════════════════
# AbsenKu Environment — base setup
# Copy ke .env (atau set via dashboard deployment)
# ══════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=absenku
POSTGRES_USER=absenku
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_here

# ── MinIO (container) ──
MINIO_ROOT_USER=minioman
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password

# ── Backend ──
BACKEND_PORT=9090
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_random_string_here!!
BETTER_AUTH_URL=http://localhost:9090
CORS_ORIGIN=http://localhost:5173
DEMO_PASSWORD=password
APP_RELEASE_DATE=2026-07-13

# ── MinIO public access (backend perspective) ──
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET_FOTO=absenku-foto
MINIO_BUCKET_ABSENSI=absenku-absensi

# ── Frontend ──
VITE_API_URL=http://localhost:9090
FRONTEND_PORT=5173
