# ══════════════════════════════════════════════════════
# AbsenKu Production Environment
# Copy to .env and fill in values before deployment
# ══════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=absenku
POSTGRES_USER=absenku
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_here

# ── MinIO (object storage) ──
MINIO_ROOT_USER=CHANGE_ME_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password

# ── Backend ──
BACKEND_PORT=9090
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_random_string_here!!
BETTER_AUTH_URL=https://api.yourdomain.com
CORS_ORIGIN=https://yourdomain.com
DEMO_PASSWORD=CHANGE_ME_or_remove_seeder
APP_RELEASE_DATE=2026-07-13

# ── MinIO public access (backend perspective) ──
MINIO_PUBLIC_URL=https://storage.yourdomain.com
MINIO_BUCKET_FOTO=absenku-foto
MINIO_BUCKET_ABSENSI=absenku-absensi

# ── Frontend ──
VITE_API_URL=https://api.yourdomain.com
FRONTEND_PORT=80
