{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".agents/**",
    "dist/**",
    "node_modules/**",
    "public/models/**"
  ]
}